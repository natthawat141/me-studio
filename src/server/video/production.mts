 const actions:Record<string,string>={save_file_to_downloads:'write',list_audio_assets:'read',set_audio_track:'write',list_generated_files:'read',open_generated_file:'inspect',list_project_files:'read',read_project_file:'read',write_project_file:'write',save_html_animation:'write',capture_project_html:'inspect',open_project_file:'inspect',inspect_animation:'inspect',render_video:'render',trim_video:'render',read_current_animation:'read'};
 for(const tool of tools){const original=tool.execute;tool.execute=async(id,args,signal,onUpdate)=>{const action=actions[tool.name];const path=(args as {path?:unknown})?.path;const relativePath=typeof path==='string'&&path.length<=400&&!isAbsolute(path)&&!/[\\:\x00-\x1f]/.test(path)&&!path.split('/').some(p=>p==='..'||p.startsWith('.'))?path:tool.name==='save_html_animation'?`design-${draftRevision+1}.html`:undefined;const operationId=randomUUID();const emit=(status:string)=>{if(action)options.onActivity?.({operationId,action,status,...(relativePath?{relativePath}:{})});};emit('started');try{const result=await original(id,args,signal,onUpdate);emit('completed');return result;}catch(e){emit('failed');throw e;}};}
 return {tools,directory,source,save,saveHtml,voice,render,inspect,resultFiles:()=>resultFiles.slice(-8),assets:workspace.assets,artifact:()=>lastArtifact,previews:()=>previewPaths.slice(-6),choices:()=>choices,
