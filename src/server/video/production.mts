 {name:'save_html_animation',label:'ออกแบบภาพและแอนิเมชัน',description:'Create the visual medium and art direction requested by the user using HTML/CSS/inline SVG and CSS keyframes as rendering materials. HTML is the implementation, not a website aesthetic. No fixed style, cast, scene, duration or layout. No scripts, event handlers, external URLs, imports or external fonts. Use registered local images from list_visual_assets via exact img src paths; system fonts and CSS animations; the host pauses/seeks animations deterministically. Saves a version, sends a real preview to chat and RETURNS THREE ACTUAL DRAFT FRAMES in this same response for your inspection. Do not call inspect_animation again for this unchanged draft. Does NOT render MP4. narration is optional. Up to 300 seconds in one continuous timeline. Preserve the full requested duration; do not split a single video request into separately delivered clips.',parameters:z.toJSONSchema(creativeSchema) as TSchema,execute:async(_id,args)=>{const saved=await saveHtml(args);const checked=await inspect();return {...checked,content:[...output({...saved,inspectionIncluded:true}).content,...checked.content]};}},
