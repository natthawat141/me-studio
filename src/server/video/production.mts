 if(options.exportDirectory)tools.push({name:'save_file_to_downloads',label:'Save a copy to Downloads',description:'Copy an actual generated file to the Mac Downloads folder when the user requests saving it there. First use list_generated_files to choose the exact existing file ID. Preserves the original and uses a numbered filename if the destination exists. No arbitrary destination paths, no regeneration. For another folder, the user can use Save a copy in the app and choose it in the native folder picker. Copies one file; HTML relative assets are not bundled.',parameters:Type.Object({id:Type.String({format:'uuid'}),name:Type.Optional(Type.String({minLength:1,maxLength:200}))},{additionalProperties:false}),execute:async(_id,args)=>{
  const value=z.object({id:z.string().uuid(),name:z.string().min(1).max(200).optional()}).strict().parse(args),file=await generated.resolve(value.id);
