 const probeVideo=async(path:string)=>JSON.parse((await runTool(options.toolPaths?.ffprobe||'ffprobe',['-v','error','-show_entries','format=duration:stream=codec_type','-of','json',path],{timeout:15000,signal:options.signal})).stdout) as {format:{duration:string};streams:{codec_type:string}[]};
