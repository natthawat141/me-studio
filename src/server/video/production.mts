 const metadata=await probeVideo(path);if(Math.abs(Number(metadata.format.duration)-(v.end-v.start))>.2||(hasVoice&&!metadata.streams.some(x=>x.codec_type==='audio')))throw Error('TRIM_VALIDATION_FAILED');
 lastArtifact={id,path,title:sourceVideo.title,durationSeconds:v.end-v.start,hasVoice};await publish(path,outputRoot,true,sourceVideo.title);return output(lastArtifact);
