 const audioSelectionPath=options.sessionId?join(options.stateRoot??options.skillRoot,`audio-track-${options.sessionId}.json`):undefined;
 let audioSelection:z.infer<typeof audioSelectionSchema>|null=null;
 if(audioSelectionPath){try{if(await realpath(audioSelectionPath)!==audioSelectionPath||(await stat(audioSelectionPath)).size>2000)throw Error('INVALID_AUDIO_STATE');const raw=JSON.parse(await readFile(audioSelectionPath,'utf8'));audioSelection=raw===null?null:audioSelectionSchema.parse(raw);}catch(e){if((e as NodeJS.ErrnoException).code!=='ENOENT')throw e;}}
 async function persistAudio(){if(audioSelectionPath){const temporary=audioSelectionPath+'.'+randomUUID()+'.tmp';await writeFile(temporary,JSON.stringify(audioSelection),{flag:'wx',mode:0o600});await rename(temporary,audioSelectionPath);}}
 async function applyAudio(){
  if(!audioSelection)return;
  const audio=await audioAssets.resolve(audioSelection.id),duration=creative?.durationSeconds??scene?.durationSeconds;
  if(!duration)throw Error('SAVE_ANIMATION_FIRST');
  if(audioSelection.startSeconds+audio.durationSeconds>duration+.1)throw Error('AUDIO_EXCEEDS_TIMELINE');
  await ensureDirectory();const file=`audio-${audio.id}.wav`,path=join(directory,file),bytes=await readFile(audio.path);
  try{await writeFile(path,bytes,{flag:'wx',mode:0o600});}catch(e){if((e as NodeJS.ErrnoException).code!=='EEXIST')throw e;if(await realpath(path)!==path||!(await readFile(path)).equals(bytes))throw Error('AUDIO_CHANGED');}
  tracks.splice(0,tracks.length,{file,startMs:Math.round(audioSelection.startSeconds*1000),volume:audioSelection.volume});speechReady=true;
 }
 async function setAudio(raw:unknown){
  const next=z.object({id:z.string().uuid().nullable(),startSeconds:z.number().min(0).max(300).default(0),volume:z.number().min(0).max(2).default(1)}).strict().parse(raw);
  if(next.id===null){audioSelection=null;tracks.length=0;speechReady=false;artifactRevision=-1;await persistAudio();return {selected:false};}
  const audio=await audioAssets.resolve(next.id),duration=creative?.durationSeconds??scene?.durationSeconds;
  if(duration&&next.startSeconds+audio.durationSeconds>duration+.1)throw Error('AUDIO_EXCEEDS_TIMELINE');
  audioSelection={id:next.id,startSeconds:next.startSeconds,volume:next.volume};await persistAudio();artifactRevision=-1;
  if(duration){await applyAudio();await manifest();}
  return {selected:true,audio:{id:audio.id,name:audio.name,durationSeconds:audio.durationSeconds},startSeconds:next.startSeconds,volume:next.volume};
 }

 async function manifest(){if(!scene&&!creative)throw Error('SAVE_ANIMATION_FIRST');await ensureDirectory();await writeFile(join(directory,'project.json'),JSON.stringify({version:1,title:creative?.title??scene!.title,entry:'scene.html',width:creative?.width??(scene!.layout==='portrait'?540:960),height:creative?.height??(scene!.layout==='portrait'?960:540),fps:24,durationSeconds:creative?.durationSeconds??scene!.durationSeconds,assets:creative?workspace.assets().map(a=>a.src):[],audio:tracks},null,2));}
 async function save(raw:unknown){await ensureDirectory();scene=sceneSchema.parse(raw);creative=undefined;speechReady=false;tracks.length=0;await writeFile(join(directory,'scene.json'),JSON.stringify(scene,null,2));await writeFile(join(directory,'scene.html'),compileAnimation(scene));await writeFile(join(directory,'storyboard.md'),`# ${scene.title}\n\n${scene.cues.map((c,i)=>`${i+1}. ${c.start}–${c.end}s: ${scene!.characters[c.speaker].name} / ${c.action} / ${c.text}`).join('\n')}\n\nEnding: ${scene.ending}\n`);await manifest();return {saved:true,durationSeconds:scene.durationSeconds,cues:scene.cues.length};}
 async function saveHtml(raw:unknown){const next=creativeSchema.parse(raw);if(!options.toolPaths)throw Error('BROWSER_REQUIRED');await ensureDirectory();const path=join(directory,`preview-${previewPaths.length+1}.png`);const html=await prepareHtmlPreview(next.html,{browser:options.toolPaths.browser,width:next.width,height:next.height,timeMs:Math.min(1200,next.durationSeconds*500),path,assets:await workspace.imageInputs(),signal:options.signal});for(const [name,asset] of Object.entries(await workspace.imageInputs())){await mkdir(join(directory,'assets'),{recursive:true});try{await writeFile(join(directory,name),asset.bytes,{flag:'wx',mode:0o600});}catch(e){if((e as NodeJS.ErrnoException).code!=='EEXIST')throw e;}}draftRevision++;creative=next;scene=undefined;speechReady=false;tracks.length=0;await writeFile(join(directory,'scene.html'),html,{mode:0o600});await writeFile(join(directory,`design-${draftRevision}.html`),next.html,{mode:0o600});await publish(join(directory,`design-${draftRevision}.html`),outputRoot,true,next.title);await publish(path,outputRoot,false,next.title+' — ภาพตัวอย่าง');await manifest();versions=[...versions,next].slice(-20);if(statePath){const temporary=statePath+'.'+randomUUID()+'.tmp';await writeFile(temporary,JSON.stringify(versions),{flag:'wx',mode:0o600});await rename(temporary,statePath);}previewPaths.push(path);return {saved:true,title:next.title,durationSeconds:next.durationSeconds,preview:true};}
 async function voice(){if(audioSelection)throw Error('VOICE_EXISTING_AUDIO_SELECTED');if(creative&&previewPaths.length===0)await saveHtml(creative);if(!scene&&!creative)throw Error('SAVE_ANIMATION_FIRST');if(creative&&!creative.narration)throw Error('VOICE_TEXT_REQUIRED');if(!options.elevenKey)throw Error('VOICE_KEY_REQUIRED');if(speechReady)return {ready:true};if(voiceCalls>=8)throw Error('VOICE_CALL_LIMIT');tracks.length=0;
  await ensureDirectory();for(const [i,cue] of (creative?[{start:0,end:creative.durationSeconds,text:creative.narration}]:scene!.cues).entries()){
   options.signal?.throwIfAborted();voiceCalls++;if(voiceCalls>8)throw Error('VOICE_CALL_LIMIT');const response=await fetch(`https://api.elevenlabs.io/v1/text-to-speech/${encodeURIComponent(options.voiceId||'JBFqnCBsd6RMkjVDRZzb')}`,{method:'POST',headers:{'xi-api-key':options.elevenKey,'Content-Type':'application/json'},body:JSON.stringify({model_id:options.speechModel||'eleven_v3',text:cue.text,language_code:options.language||'th'}),signal:AbortSignal.any([...(options.signal?[options.signal]:[]),AbortSignal.timeout(60000)])});
   if(!response.ok){await response.body?.cancel();throw Error(`VOICE_HTTP_${response.status}`);}const bytes=Buffer.from(await response.arrayBuffer());if(bytes.length>8*1024*1024)throw Error('VOICE_TOO_LARGE');const file=`voice-${voiceCalls}-${i}.mp3`;await writeFile(join(directory,file),bytes,{flag:'wx',mode:0o600});
   const {stdout}=await runTool(options.toolPaths?.ffprobe||'ffprobe',['-v','error','-show_entries','format=duration','-of','json',join(directory,file)]);const duration=Number(JSON.parse(stdout).format.duration);if(!Number.isFinite(duration)||duration>cue.end-cue.start+.1)throw Error('VOICE_EXCEEDS_CUE');tracks.push({file,startMs:Math.round(cue.start*1000),volume:1});
  }speechReady=true;await manifest();return {ready:true,tracks:tracks.length};
 }
 async function render(requireVoice:boolean){if(creative&&previewPaths.length===0)await saveHtml(creative);if(!scene&&!creative)throw Error('SAVE_ANIMATION_FIRST');await applyAudio();if(requireVoice&&!speechReady)throw Error('VOICE_NOT_READY');if(renderAttempts>=3)throw Error('RENDER_ATTEMPT_LIMIT');renderAttempts++;await manifest();const rendered=await renderProject(join(directory,'project.json'),{outputRoot:join(directory,'renders'),signal:options.signal,toolPaths:options.toolPaths,onProgress:options.onProgress});lastArtifact={id:rendered.id,path:rendered.outputPath,poster:join(rendered.directory,'poster.png'),title:creative?.title??scene!.title,durationSeconds:creative?.durationSeconds??scene!.durationSeconds,hasVoice:speechReady};artifactRevision=draftRevision;await publish(rendered.outputPath,outputRoot,true,String(lastArtifact.title));return lastArtifact;}
 async function inspect(){
  options.signal?.throwIfAborted();if(!creative||!options.toolPaths)throw Error('SAVE_HTML_ANIMATION_FIRST');await ensureDirectory();
  const actual=!!lastArtifact&&artifactRevision===draftRevision;
  const duration=Number(actual?lastArtifact!.durationSeconds:creative.durationSeconds);
  let metadata:unknown={durationSeconds:duration,width:creative.width,height:creative.height,source:'draft'};
  if(actual){const probe=await runTool(options.toolPaths.ffprobe,['-v','error','-show_entries','format=duration:stream=codec_type,width,height','-of','json',String(lastArtifact!.path)],{signal:options.signal});metadata={...JSON.parse(probe.stdout),source:'rendered-mp4'};}
  const content:({type:'text';text:string}|{type:'image';mimeType:string;data:string})[]=[{type:'text',text:JSON.stringify({metadata,renderAttempts,remainingRenderAttempts:3-renderAttempts})}];
  for(const time of [0,duration/2,Math.max(0,duration-1/24)]){
   const path=join(directory,'inspection-'+randomUUID()+'.png'),jpeg=path+'.jpg';
   if(actual)await runTool(options.toolPaths.ffmpeg,['-hide_banner','-loglevel','error','-ss',String(time),'-i',String(lastArtifact!.path),'-frames:v','1','-y',path],{signal:options.signal});
   else await prepareHtmlPreview(creative.html,{browser:options.toolPaths.browser,width:creative.width,height:creative.height,timeMs:time*1000,path,assets:await workspace.imageInputs(),signal:options.signal});
   await runTool(options.toolPaths.ffmpeg,['-hide_banner','-loglevel','error','-i',path,'-frames:v','1','-vf','scale=768:768:force_original_aspect_ratio=decrease','-q:v','5','-y',jpeg],{signal:options.signal});
   const bytes=await readFile(jpeg);if(bytes.length>250000)throw Error('INSPECTION_IMAGE_TOO_LARGE');
   content.push({type:'text',text:`${actual?'Rendered MP4':'Draft'} frame at ${time.toFixed(3)}s`},{type:'image',mimeType:'image/jpeg',data:bytes.toString('base64')});
  }return {content,details:{}};
 }
