 {name:'list_visual_assets',label:'ดูภาพอ้างอิง',description:'List actual uploaded and imported images. Use their exact src in HTML img elements to preserve the original artwork; do not invent paths or asset IDs.',parameters:Type.Object({},{additionalProperties:false}),execute:async()=>output({assets:workspace.assets()})},
