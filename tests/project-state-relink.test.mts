import {test} from 'node:test';import assert from 'node:assert/strict';import {mkdtemp,mkdir,writeFile,readFile,rm,symlink} from 'node:fs/promises';import {join} from 'node:path';import {tmpdir} from 'node:os';import {randomUUID} from 'node:crypto';import {createProductionTools,initializeSkills} from '../src/server/video/production.mjs';import {resolve} from 'node:path';import {prepareProjectState} from '../src/server/video/project-state.mjs';
test('working state survives source relink without moving originals or overwriting corrupt state',async()=>{
 const dir=await mkdtemp(join(tmpdir(),'studio-state-'));try{const source=join(dir,'a'),other=join(dir,'b'),data=join(dir,'data'),pid=randomUUID(),sid=randomUUID();await mkdir(join(source,'.me-studio/skills'),{recursive:true});await mkdir(other);const draft=JSON.stringify([{title:'My draft',html:'<p>keep</p>',width:320,height:320,durationSeconds:2,narration:''}]);await writeFile(join(source,'.me-studio/skills',`draft-${sid}.json`),draft);
 const first=await prepareProjectState({data,projectId:pid,sessionId:sid,source});const second=await prepareProjectState({data,projectId:pid,sessionId:sid,source:other});assert.equal(first,second);assert.equal(await readFile(join(first,`draft-${sid}.json`),'utf8'),draft);assert.equal(await readFile(join(source,'.me-studio/skills',`draft-${sid}.json`),'utf8'),draft);
 const skillRoot=await initializeSkills(other,resolve('skills'));const reopened=await createProductionTools({source:other,outputRoot:join(other,'output'),skillRoot,stateRoot:second,sessionId:sid});const read=await reopened.tools.find(t=>t.name==='read_current_animation')!.execute('reopen',{});assert.match(JSON.stringify(read),/My draft/);
 await writeFile(join(first,`draft-${sid}.json`),'corrupt');await prepareProjectState({data,projectId:pid,sessionId:sid,source});assert.equal(await readFile(join(first,`draft-${sid}.json`),'utf8'),'corrupt');
 const evil=randomUUID();await mkdir(join(source,'.me-studio/skills',`workspace-${evil}`));await symlink('/etc/hosts',join(source,'.me-studio/skills',`workspace-${evil}`,'assets.json'));await assert.rejects(prepareProjectState({data,projectId:pid,sessionId:evil,source}),/INVALID_PROJECT_STATE/);
 }finally{await rm(dir,{recursive:true,force:true});}
});
