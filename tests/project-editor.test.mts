import {test} from 'node:test';import assert from 'node:assert/strict';import {mkdtemp,mkdir,rm} from 'node:fs/promises';import {join} from 'node:path';import {tmpdir} from 'node:os';import {ProjectFolders} from '../desktop/project-folders.mjs';import {ProjectEdits} from '../desktop/project-edits.mjs';
test('staged folder edits are cancelled without writes and Save is one revision-checked update',async()=>{const root=await mkdtemp(join(tmpdir(),'studio-editor-'));try{for(const n of ['a','b'])await mkdir(join(root,n));const store=new ProjectFolders(join(root,'registry.json'));const p=await store.create('Custom',join(root,'a'));const edits=new ProjectEdits(store,async()=>{});const first=await edits.begin(p.id);await edits.select(first.token,'source',join(root,'b'));edits.cancel(first.token);assert.equal((await store.list())[0].sourcePath,p.sourcePath);await assert.rejects(edits.save({token:first.token,name:'No'}),/INVALID_EDIT/);const second=await edits.begin(p.id);await edits.select(second.token,'source',join(root,'b'));const saved=await edits.save({token:second.token,name:'Renamed',nameOrigin:'custom'});assert.equal(saved.id,p.id);assert.equal(saved.folderName,'b');assert.equal(saved.name,'Renamed');assert.equal(saved.revision,1);await assert.rejects(edits.save({token:second.token,name:'again'}),/INVALID_EDIT/);}finally{await rm(root,{recursive:true,force:true});}});
test('legacy explicit default output follows staged source selection while custom exports remain stable',async()=>{const root=await mkdtemp(join(tmpdir(),'studio-output-'));try{await mkdir(join(root,'a/output'),{recursive:true});await mkdir(join(root,'b'));const store=new ProjectFolders(join(root,'registry.json'));const p=await store.create('Show',join(root,'a'));await store.setOutput(p.id,join(root,'a/output'));const edits=new ProjectEdits(store);const edit=await edits.begin(p.id);const candidate=await edits.select(edit.token,'source',join(root,'b'));const saved=await edits.save({token:edit.token,name:edit.name,nameOrigin:'custom'});assert.equal(saved.outputPath,candidate.outputPath);}finally{await rm(root,{recursive:true,force:true});}});
test('relink recovers a directory renamed on disk and migrates its legacy state',async()=>{const root=await mkdtemp(join(tmpdir(),'studio-moved-'));try{const {rename}=await import('node:fs/promises');const {prepareProjectRelink}=await import('../src/server/video/project-state.mjs');await mkdir(join(root,'a'));const store=new ProjectFolders(join(root,'registry.json'));const p=await store.create('Show',join(root,'a'));await rename(join(root,'a'),join(root,'b'));const edits=new ProjectEdits(store,async(id,source,replacement)=>{await prepareProjectRelink({data:join(root,'data'),projectId:id,source});await prepareProjectRelink({data:join(root,'data'),projectId:id,source:replacement});});const edit=await edits.begin(p.id);await edits.select(edit.token,'source',join(root,'b'));const saved=await edits.save({token:edit.token,name:edit.name,nameOrigin:'custom'});assert.equal(saved.folderName,'b');}finally{await rm(root,{recursive:true,force:true});}});
