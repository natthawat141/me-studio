{
  "name": "me-studio",
  "version": "0.2.1",
  "private": true,
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "agent:demo": "tsx scripts/local/agent-demo.mts",
    "local:doctor": "node scripts/local/doctor.mjs",
    "local:setup": "node scripts/local/setup.mjs",
    "local:render": "node scripts/local/cli.mjs",
    "local:demo": "node scripts/local/cli.mjs --project examples/local-render/project.json",
    "local:smoke": "node scripts/local/smoke.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "tsx --test tests/*.test.ts tests/*.test.mts",
    "test:api": "tsx tests/http.integration.ts",
    "test:ui": "playwright test",
    "desktop:stage": "npm run build && npm run agent:python-build && node scripts/desktop/build.mjs",
    "desktop:dev": "electron dist-desktop/main.mjs",
    "desktop:build": "npm run desktop:stage && electron-builder --config desktop/electron-builder.yml --mac dir --arm64",
    "desktop:smoke": "node scripts/desktop/smoke.mjs",
    "video:produce": "tsx scripts/local/produce-video.mts",
    "agent:python-setup": "python3 -m venv .studio/python-env && .studio/python-env/bin/python -m pip install -r python/requirements.lock",
    "agent:python-test": ".studio/python-env/bin/python -m unittest discover -s python/tests -v",
    "agent:python-demo": "tsx scripts/local/python-agent-demo.mts",
    "agent:python-build": "node scripts/desktop/build-python.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@earendil-works/pi-agent-core": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "@ffmpeg-installer/darwin-arm64": "4.1.5",
    "@ffprobe-installer/darwin-arm64": "5.0.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.1",
    "lucide-react": "^1.66.0",
    "next": "16.4.3",
    "openai": "7.47.0",
    "playwright-core": "1.64.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "server-only": "^0.0.1",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0",
    "typebox": "1.3.27",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "22.19.19",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
