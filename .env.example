# Copy to .env.local. This example contains NO real credentials.
# Modes describe deployment intent; selecting saas does not implement auth/billing.
STUDIO_MODE=demo
OPENROUTER_API_KEY=
META_API_KEY=
ELEVENLABS_API_KEY=
# Operator-approved models from the provider catalog. No model is enabled by default.
# Example format: [{"id":"<actual OpenRouter model ID>","label":"My chat model","family":"meta-llama"}]
STUDIO_CHAT_MODELS=[]
# Actual model IDs from ElevenLabs /v1/models, after checking TTS/language support.
STUDIO_SPEECH_MODELS=[]

# Meta direct API; IDs checked against https://dev.meta.ai/docs/models on 2026-11-01.
# STUDIO_META_MODELS=[{"id":"muse-wonder-1.0","label":"Muse Wonder","family":"muse"}]
STUDIO_META_MODELS=[]
# Current OpenRouter examples (checked 2026-11-01); review capability/access before enabling:
# STUDIO_CHAT_MODELS=[{"id":"anthropic/claude-haiku-5.5","label":"Claude Haiku 5.5"},{"id":"meta/muse-wonder","label":"Muse Wonder"}]
